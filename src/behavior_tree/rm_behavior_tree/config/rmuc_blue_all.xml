<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Untitled">
    <ReactiveSequence>
      <SubAllRobotHP topic_name="robot_hp"
                     robot_hp="{robot_hp}"/>
      <SubRobotStatus topic_name="robot_status"
                      />
      <SubGameStatus topic_name="game_status"
                     game_status="{game_status}"/>
      <WhileDoElse>
        <IsGameTime message="{game_status}"
                    game_progress="4"
                    lower_remain_time="362"
                    higher_remain_time="420"/>
        <Repeat num_cycles="-1">
          <ReactiveFallback>
            <Sequence>
              <IsOutpostOK 
                           all_robot_hp="{robot_hp}"
                           hp_threshold="10"/>
              <IsStatusOK message="{robot_status}"
                          hp_threshold="250"
                          heat_threshold="0"/>
              <Repeat num_cycles="-1">
                <SendGoal goal_pose="7.4;6.6;0; 0;0;0;1"
                          action_name="/red_standard_robot1/navigate_to_pose"/>
              </Repeat>
            </Sequence>
            <Sequence>
              <IsStatusOK message="{robot_status}"
                          hp_threshold="250"
                          heat_threshold="0"/>
              <SendGoal goal_pose="2.7;2.6;0; 0;0;0;1"
                        action_name="/red_standard_robot1/navigate_to_pose"/>
            </Sequence>
            <Sequence>
              <RetryUntilSuccessful num_attempts="-1">
                <SendGoal goal_pose="-0.5;-4.2;0; 0;0;0;1"
                          action_name="/red_standard_robot1/navigate_to_pose"/>
              </RetryUntilSuccessful>
              <RetryUntilSuccessful num_attempts="-1">
                <IsStatusOK message="{robot_status}"
                            hp_threshold="399"
                            heat_threshold="0"/>
              </RetryUntilSuccessful>
            </Sequence>
          </ReactiveFallback>
        </Repeat>
      </WhileDoElse>
      <WhileDoElse>
        <IsGameTime message="{game_status}"
                    game_progress="4"
                    lower_remain_time="302"
                    higher_remain_time="361"/>
        <Repeat num_cycles="-1">
          <ReactiveFallback>
            <Sequence>
              <IsTimeToBullet message="{game_status}"
                              game_progress="4"
                              time_to_bullet="360"/>
              <RetryUntilSuccessful num_attempts="-1">
                <SendGoal goal_pose="-0.5;-4.2;0; 0;0;0;1"
                          action_name="/red_standard_robot1/navigate_to_pose"/>
              </RetryUntilSuccessful>
            </Sequence>
            <Sequence>
              <IsOutpostOK 
                           all_robot_hp="{robot_hp}"
                           hp_threshold="10"/>
              <IsStatusOK message="{robot_status}"
                          hp_threshold="250"
                          heat_threshold="0"/>
              <Repeat num_cycles="-1">
                <SendGoal goal_pose="4.8;8.7;0; 0;0;0;1"
                          action_name="/red_standard_robot1/navigate_to_pose"/>
              </Repeat>
            </Sequence>
            <Sequence>
              <IsStatusOK message="{robot_status}"
                          hp_threshold="250"
                          heat_threshold="0"/>
              <SendGoal goal_pose="2.7;2.6;0; 0;0;0;1"
                        action_name="/red_standard_robot1/navigate_to_pose"/>
            </Sequence>
            <Sequence>
              <RetryUntilSuccessful num_attempts="-1">
                <SendGoal goal_pose="-0.5;-4.2;0; 0;0;0;1"
                          action_name="/red_standard_robot1/navigate_to_pose"/>
              </RetryUntilSuccessful>
              <RetryUntilSuccessful num_attempts="-1">
                <IsStatusOK message="{robot_status}"
                            hp_threshold="399"
                            heat_threshold="0"/>
              </RetryUntilSuccessful>
            </Sequence>
          </ReactiveFallback>
        </Repeat>
      </WhileDoElse>
      <WhileDoElse>
        <IsGameTime message="{game_status}"
                    game_progress="4"
                    lower_remain_time="0"
                    higher_remain_time="301"/>
        <Repeat num_cycles="-1">
          <ReactiveFallback>
            <Sequence>
              <IsTimeToBullet message="{game_status}"
                              game_progress="4"
                              time_to_bullet="60 120 180 240 300"/>
              <RetryUntilSuccessful num_attempts="-1">
                <SendGoal goal_pose="-0.5;-4.2;0; 0;0;0;1"
                          action_name="/red_standard_robot1/navigate_to_pose"/>
              </RetryUntilSuccessful>
            </Sequence>
            <Sequence>
              <IsOutpostOK 
                           all_robot_hp="{robot_hp}"
                           hp_threshold="10"/>
              <IsStatusOK message="{robot_status}"
                          hp_threshold="250"
                          heat_threshold="0"/>
              <Repeat num_cycles="-1">
                <Sequence>
                  <SendGoal goal_pose="1.6;4.1;0; 0;0;0;1"
                            action_name="/red_standard_robot1/navigate_to_pose"/>
                  <SendGoal goal_pose="4.5;4.9;0; 0;0;0;1"
                            action_name="/red_standard_robot1/navigate_to_pose"/>
                  <SendGoal goal_pose="1.9;0.2;0; 0;0;0;1"
                            action_name="/red_standard_robot1/navigate_to_pose"/>
                  <SendGoal goal_pose="5.1;-0.4;0; 0;0;0;1"
                            action_name="/red_standard_robot1/navigate_to_pose"/>
                </Sequence>
              </Repeat>
            </Sequence>
            <Sequence>
              <IsStatusOK message="{robot_status}"
                          hp_threshold="250"
                          heat_threshold="0"/>
              <SendGoal goal_pose="2.7;2.6;0; 0;0;0;1"
                        action_name="/red_standard_robot1/navigate_to_pose"/>
            </Sequence>
            <Sequence>
              <RetryUntilSuccessful num_attempts="-1">
                <SendGoal goal_pose="-0.5;-4.2;0; 0;0;0;1"
                          action_name="/red_standard_robot1/navigate_to_pose"/>
              </RetryUntilSuccessful>
              <RetryUntilSuccessful num_attempts="-1">
                <IsStatusOK message="{robot_status}"
                            hp_threshold="399"
                            heat_threshold="0"/>
              </RetryUntilSuccessful>
            </Sequence>
          </ReactiveFallback>
        </Repeat>
      </WhileDoElse>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="IsGameTime"
            editable="true">
      <input_port name="message"
                  default="{game_status}"/>
      <input_port name="game_progress"
                  default="4"/>
      <input_port name="lower_remain_time"
                  default="0"/>
      <input_port name="higher_remain_time"
                  default="300"/>
    </Action>
    <Action ID="IsOutpostOK"
            editable="true">
                  default="{robot_status}"/>
      <input_port name="all_robot_hp"
                  default="{robot_hp}"/>
      <input_port name="hp_threshold"
                  default="10"/>
    </Action>
    <Action ID="IsStatusOK"
            editable="true">
      <input_port name="message"
                  default="{robot_status}"/>
      <input_port name="hp_threshold"
                  default="100"/>
      <input_port name="heat_threshold"
                  default="350"/>
    </Action>
    <Action ID="IsTimeToBullet"
            editable="true">
      <input_port name="message"
                  default="{game_status}"/>
      <input_port name="game_progress"
                  default="4"/>
      <input_port name="time_to_bullet"
                  default="60 120 180 240"/>
    </Action>
    <Action ID="SendGoal"
            editable="true">
      <input_port name="goal_pose"
                  default="0;0;0; 0;0;0;1"/>
      <input_port name="action_name"
                  default="navigate_to_pose"/>
    </Action>
    <Action ID="SubAllRobotHP"
            editable="true">
      <input_port name="topic_name"
                  default="robot_hp"/>
      <output_port name="robot_hp"
                   default="{robot_hp}"/>
    </Action>
    <Action ID="SubGameStatus"
            editable="true">
      <input_port name="topic_name"
                  default="game_status"/>
      <output_port name="game_status"
                   default="{game_status}"/>
    </Action>
    <Action ID="SubRobotStatus"
            editable="true">
      <input_port name="topic_name"
                  default="robot_status"/>
      <output_port name="robot_status"
                   default="{robot_status}"/>
    </Action>
  </TreeNodesModel>

</root>
