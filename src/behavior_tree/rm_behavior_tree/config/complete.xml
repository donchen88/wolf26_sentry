<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Untitled">
    <ReactiveSequence>
      <SubRobotStatus topic_name="robot_status"
                      robot_status="{robot_status}"/>
      <SubGameStatus topic_name="game_status"
                     game_status="{game_status}"/>
      <Fallback>
        <Sequence>
          <Inverter>
            <IsStatusOK message="{robot_status}"
                        hp_threshold="130"
                        heat_threshold="10"
                        barrel_heat_limit_threshold="500"/>
          </Inverter>
          <SequenceWithMemory>
            <PubRobotState topic_name="robot_state"
                           robot_state="1"/>
            <SendGoal goal_pose="0.571464; 0.0906296; 0; 0;0;0;1"
                      action_name="/red_standard_robot1/navigate_to_pose"/>
          </SequenceWithMemory>
        </Sequence>
        <Sequence>
          <IsGameTime message="{game_status}"
                      game_progress="4"
                      lower_remain_time="220"
                      higher_remain_time="420"/>
          <SequenceWithMemory>
            <SendGoal goal_pose="11.1606; -1.30272; 0; 0;0;0;1"
                      action_name="/red_standard_robot1/navigate_to_pose"/>
            <PubRobotState topic_name="robot_state"
                           robot_state="3"/>
          </SequenceWithMemory>
        </Sequence>
        <Sequence>
          <IsGameTime message="{game_status}"
                      game_progress="4"
                      lower_remain_time="0"
                      higher_remain_time="219"/>
          <SequenceWithMemory>
            <SendGoal goal_pose="5.3183; -2.78461; 0; 0;0;0;1"
                      action_name="navigate_to_pose"/>
            <PubRobotState topic_name="robot_state"
                           robot_state="2"/>
          </SequenceWithMemory>
        </Sequence>
      </Fallback>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="IsGameTime"
            editable="true">
      <input_port name="message"
                  default="{game_status}"/>
      <input_port name="game_progress"
                  default="4"/>
      <input_port name="lower_remain_time"
                  default="0"/>
      <input_port name="higher_remain_time"
                  default="300"/>
    </Action>
    <Action ID="IsStatusOK"
            editable="true">
      <input_port name="message"
                  default="{robot_status}"/>
      <input_port name="hp_threshold"
                  default="100"/>
      <input_port name="heat_threshold"
                  default="350"/>
      <input_port name="barrel_heat_limit_threshold"
                  default="0"/>
    </Action>
    <Action ID="PubRobotState"
            editable="true">
      <input_port name="topic_name"
                  default="robot_state"/>
      <input_port name="robot_state"
                  default="1">1=移动姿态，2=防御姿态，3=进攻姿态</input_port>
    </Action>
    <Action ID="SendGoal"
            editable="true">
      <input_port name="goal_pose"
                  default="0;0;0; 0;0;0;1"/>
      <input_port name="action_name"
                  default="navigate_to_pose"/>
    </Action>
    <Action ID="SubGameStatus"
            editable="true">
      <input_port name="topic_name"
                  default="game_status"/>
      <output_port name="game_status"
                   default="{game_status}"/>
    </Action>
    <Action ID="SubRobotStatus"
            editable="true">
      <input_port name="topic_name"
                  default="robot_status"/>
      <output_port name="robot_status"
                   default="{robot_status}"/>
    </Action>
  </TreeNodesModel>

</root>
