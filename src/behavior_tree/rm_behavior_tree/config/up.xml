<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="tes">
    <IsTimeToBullet message="{game_status}"
                    game_progress="4"
                    time_to_bullet="60 120 180 240 410 405 400 395 390"/>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="IsTimeToBullet"
            editable="true">
      <input_port name="message"
                  default="{game_status}"/>
      <input_port name="game_progress"
                  default="4"/>
      <input_port name="time_to_bullet"
                  default="60 120 180 240"/>
    </Action>
  </TreeNodesModel>

</root>
