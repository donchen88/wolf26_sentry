<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="2026_wwlf_rmul2">
    <ReactiveSequence>
      <SubRobotStatus topic_name="robot_status"
                      robot_status="{robot_status}"/>
      <SubGameStatus topic_name="game_status"
                     game_status="{game_status}"/>
      <SubAutoAimStatus topic_name="auto_aim_status"
                        auto_aim_status="{auto_aim_status}"/>
      <Fallback>
        <Sequence>
          <IsAutoAimOK message="{auto_aim_status}"
                       target_status="1"/>
          <SequenceWithMemory>
            <PubChassisMode topic_name="chassis_mode"
                            chassis_mode="1"/>
            <SendGoal goal_pose="-0.305048; 0.321999; 0; 0;0;0;1"
                      action_name="/red_standard_robot1/navigate_to_pose"/>
          </SequenceWithMemory>
        </Sequence>
        <Sequence>
          <Sequence>
            <IsGameTime message="{game_status}"
                        game_progress="4"
                        lower_remain_time="0"
                        higher_remain_time="300"/>
            <Inverter>
              <IsStatusOK message="{robot_status}"
                          hp_threshold="130"
                          heat_threshold="0"
                          barrel_heat_limit_threshold="500"/>
            </Inverter>
          </Sequence>
          <SequenceWithMemory>
            <PubSuperCapacitor topic_name="super_capacitor"
                               super_capacitor_state="1"/>
            <SendGoal goal_pose="-0.305048; 0.321999; 0; 0;0;0;1"
                      action_name="/red_standard_robot1/navigate_to_pose"/>
          </SequenceWithMemory>
          <PubSuperCapacitor topic_name="super_capacitor"
                             super_capacitor_state="0"/>
          <PubChassisMode topic_name="chassis_mode"
                          chassis_mode="0"/>
          <RetryUntilSuccessful num_attempts="-1">
            <IsStatusOK message="{robot_status}"
                        hp_threshold="400"
                        heat_threshold="1"
                        barrel_heat_limit_threshold="500"/>
          </RetryUntilSuccessful>
        </Sequence>
        <Sequence>
          <IsGameTime message="{game_status}"
                      game_progress="4"
                      lower_remain_time="0"
                      higher_remain_time="300"/>
          <PubChassisMode topic_name="chassis_mode"
                          chassis_mode="1"/>
          <SequenceWithMemory>
            <PubSuperCapacitor topic_name="super_capacitor"
                               super_capacitor_state="1"/>
            <SendGoal goal_pose="2.64841; 5.56721; 0; 0; 0; 0.0450597; 0.998984"
                      action_name="/red_standard_robot1/navigate_to_pose"/>
          </SequenceWithMemory>
          <PubSuperCapacitor topic_name="super_capacitor"
                             super_capacitor_state="0"/>
        </Sequence>
        <Sequence>
          <IsGameTime message="{game_status}"
                      game_progress="5"
                      lower_remain_time="0"
                      higher_remain_time="300"/>
          <PubChassisMode topic_name="chassis_mode"
                          chassis_mode="0"/>
        </Sequence>
      </Fallback>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="IsAutoAimOK"
               editable="true">
      <input_port name="message"
                  default="{auto_aim_status}"/>
      <input_port name="target_status"
                  default="0">1正常，0有问题</input_port>
    </Condition>
    <Action ID="IsGameTime"
            editable="true">
      <input_port name="message"
                  default="{game_status}"/>
      <input_port name="game_progress"
                  default="4"/>
      <input_port name="lower_remain_time"
                  default="0"/>
      <input_port name="higher_remain_time"
                  default="300"/>
    </Action>
    <Action ID="IsStatusOK"
            editable="true">
      <input_port name="message"
                  default="{robot_status}"/>
      <input_port name="hp_threshold"
                  default="100"/>
      <input_port name="heat_threshold"
                  default="350"/>
      <input_port name="barrel_heat_limit_threshold"
                  default="0"/>
    </Action>
    <Action ID="PubChassisMode"
            editable="true">
      <input_port name="topic_name"
                  default="chassis_mode"/>
      <input_port name="chassis_mode"
                  default="0">0=正常底盘速度, 1=加速底盘旋转, 2=过起伏路段, 3=超电状态</input_port>
    </Action>
    <Action ID="PubSuperCapacitor"
            editable="true">
      <input_port name="topic_name"
                  default="super_capacitor"/>
      <input_port name="super_capacitor_state"
                  default="0">0=关闭超电, 1=开启超电</input_port>
    </Action>
    <Action ID="SendGoal"
            editable="true">
      <input_port name="goal_pose"
                  default="0;0;0; 0;0;0;1"/>
      <input_port name="action_name"
                  default="navigate_to_pose"/>
    </Action>
    <Action ID="SubAutoAimStatus"
            editable="true">
      <input_port name="topic_name"
                  default="auto_aim_status"/>
      <input_port name="auto_aim_status"
                  default="{auto_aim_status}"/>
    </Action>
    <Action ID="SubGameStatus"
            editable="true">
      <input_port name="topic_name"
                  default="game_status"/>
      <output_port name="game_status"
                   default="{game_status}"/>
    </Action>
    <Action ID="SubRobotStatus"
            editable="true">
      <input_port name="topic_name"
                  default="robot_status"/>
      <output_port name="robot_status"
                   default="{robot_status}"/>
    </Action>
  </TreeNodesModel>

</root>
