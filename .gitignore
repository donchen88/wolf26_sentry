# ---- 构建产物 ----
build/
install/
log/
devel/
.compile_commands/
compile_commands.json

# ---- ROS ----
__pycache__/
*.py[cod]
COLCON_IGNORE

# ---- 编辑器 ----
.vscode/
.idea/
.cache/
